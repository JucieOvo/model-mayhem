# Model Mayhem 本地发行配置示例
# 本文件不包含真实密钥，禁止把 DEEPSEEK_API_KEY 提交到仓库。

HOST=127.0.0.1
PORT=3210
MODELMAYHEM_DATA_DIR=./data
MODELMAYHEM_AGENT_RUNTIME_DIR=./data/agent-runtime
MODELMAYHEM_WEB_DIR=./apps/web/dist
MODELMAYHEM_PROFILE_ID=local
MODELMAYHEM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Agent
DEEPSEEK_API_KEY=
PI_AGENT_PROMPT_TIMEOUT_MS=180000
PI_AGENT_TOOL_TIMEOUT_MS=15000

# 系统内容更新
MODELMAYHEM_UPDATE_REPOSITORY=https://github.com/JucieOvo/model-mayhem.git
MODELMAYHEM_CONTENT_BRANCH=content/stable
MODELMAYHEM_BALANCE_BRANCH=balance/stable
MODELMAYHEM_UPDATE_CHANNEL=stable
MODELMAYHEM_UPDATE_CHECK_ON_START=true
MODELMAYHEM_UPDATE_AUTO_INSTALL=false
MODELMAYHEM_CONTENT_ROOT=content
MODELMAYHEM_BALANCE_ROOT=content
MODELMAYHEM_CONTENT_PATHS=presentation,thumbnails,questions
MODELMAYHEM_BALANCE_PATHS=cards,balance,decks,research,eras,doctrines
MODELMAYHEM_GIT_EXECUTABLE=git
# 项目默认只支持回环地址；自行修改 HOST 后，网络安全和访问控制由部署者负责。
# 控制令牌不是账号体系，只保护更新、诊断和恢复等控制接口。
MODELMAYHEM_CONTROL_TOKEN=

# 本地开发前端
MODELMAYHEM_WEB_HOST=127.0.0.1
MODELMAYHEM_WEB_PORT=5173
MODELMAYHEM_SERVER_URL=http://127.0.0.1:3210

# 沙盒与开发者接口
MODELMAYHEM_SANDBOX=false
MODELMAYHEM_DEV_API=false
MODELMAYHEM_DEV_REMOTE=false
MODELMAYHEM_SANDBOX_PROFILE_ID=local-sandbox

# 日志
LOG_LEVEL=info
MODELMAYHEM_LOG_DIR=./data/logs
MODELMAYHEM_LOG_MAX_BYTES=10485760
MODELMAYHEM_LOG_MAX_FILES=7
