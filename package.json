{
  "name": "model-mayhem",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10.34.5"
  },
  "scripts": {
    "audit:game-system": "node scripts/audit-game-system.mjs",
    "apply:card-banter": "node scripts/apply-community-banter.mjs",
    "build": "pnpm --filter @modelmayhem/reference-web build",
    "check": "pnpm audit:game-system && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --parallel --filter @modelmayhem/server --filter @modelmayhem/reference-web dev",
    "dev:server": "pnpm --filter @modelmayhem/server dev",
    "dev:web": "pnpm --filter @modelmayhem/reference-web dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "start": "powershell -ExecutionPolicy Bypass -File scripts/run.ps1",
    "release:run": "powershell -ExecutionPolicy Bypass -File scripts/run.ps1",
    "package:release": "node scripts/package-release.mjs",
    "preview:community": "node scripts/build-community-preview.mjs",
    "reset:release": "node scripts/reset-release.mjs --confirm",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:release": "pnpm check && node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "better-sqlite3": "13.0.3",
    "fast-check": "4.9.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  }
}
